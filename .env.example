# Firebase web app config. Copy this file to .env.local and fill in the values
# from Firebase console > Project settings > Your apps > Web app.
# These values are not secrets (they identify the project), but keep real values
# out of git anyway. Security comes from the Firestore rules in firestore.rules.

NEXT_PUBLIC_FIREBASE_API_KEY=
# Local development: <project-id>.firebaseapp.com
# Production on Vercel: outback-safe.vercel.app (see README, "Sign-in on iPhone")
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
